// 对话转写的渲染模块。
//
// 结构照 dsh-client-ui-chat：
//   · 一轮（Turn）由若干块（Block）组成，块保持事件原始顺序；
//   · 用户消息在最前，工具调用收进一个过程组紧随其后，正文与推理按序展开；
//   · 折或不折只由档位决定（presentationPolicyFor），数据结构不掺显示决定。
//
// 列表用 LazyForEach 驱动：长会话下只创建可见的行，滚动时按需取。

import { ChatLine, foldable, lineDetail, lineKey, lineTitle } from './ChatBlocks';
import { ChatPresentationPolicy, collapseTimingOf } from '../model/Policy';
import { MarkdownView } from './MarkdownView';
import { Palette } from '../model/Palette';
import hilog from '@ohos.hilog';

export type BlockKind = 'user' | 'text' | 'reasoning' | 'tools' | 'error' | 'injection';

export interface Block {
  kind: BlockKind;
  lines: ChatLine[];
}

export interface Turn {
  key: string;
  closed: boolean;
  blocks: Block[];
  tools: ChatLine[];
}

/** 一轮内部要画的一项：用户消息 / 过程组 / 单行。 */
export interface RowItem {
  kind: string;
  line: ChatLine;
  key: string;
}

function blockKindOf(kind: string): BlockKind {
  if (kind === 'thought') {
    return 'reasoning';
  }
  if (kind === 'tool') {
    return 'tools';
  }
  if (kind === 'error') {
    return 'error';
  }
  if (kind === 'user') {
    return 'user';
  }
  if (kind === 'injection' || kind === 'checkpoint') {
    return 'injection';
  }
  return 'text';
}

/**
 * 把扁平的行归成 turn。
 *
 * @param lines 全量行
 * @param runningStart 正在跑的 turn 起始下标（-1 表示都不在跑）
 */
export function turnsOf(lines: ChatLine[], runningStart: number): Turn[] {
  const out: Turn[] = [];
  let index = 0;
  while (index < lines.length) {
    const start = index;
    let end = start + 1;
    while (end < lines.length && lines[end].kind !== 'user') {
      end += 1;
    }
    const slice = lines.slice(start, end);
    const blocks: Block[] = [];
    const tools: ChatLine[] = [];
    let current: Block | undefined = undefined;
    for (const line of slice) {
      const kind = blockKindOf(line.kind);
      if (kind === 'tools') {
        tools.push(line);
      }
      if (current !== undefined && current.kind === kind) {
        current.lines.push(line);
        continue;
      }
      const block: Block = { kind: kind, lines: [line] };
      blocks.push(block);
      current = block;
    }
    out.push({ key: 't' + String(start), closed: start !== runningStart, blocks: blocks, tools: tools });
    index = end;
  }
  return out;
}

/** 一轮要画的项，顺序固定：用户消息 → 过程组 → 其余块按原序。 */
export function itemsOf(turn: Turn): RowItem[] {
  const out: RowItem[] = [];
  for (let bi = 0; bi < turn.blocks.length; bi += 1) {
    const block = turn.blocks[bi];
    if (block.kind === 'user') {
      for (const line of block.lines) {
        out.push({ kind: 'user', line: line, key: 'u' + String(bi) + lineKey(line) });
      }
    }
  }
  if (turn.tools.length > 0) {
    out.push({ kind: 'group', line: turn.tools[0], key: 'g' + turn.key });
  }
  for (let bi = 0; bi < turn.blocks.length; bi += 1) {
    const block = turn.blocks[bi];
    if (block.kind !== 'user' && block.kind !== 'tools') {
      for (const line of block.lines) {
        out.push({ kind: 'line', line: line, key: 'b' + String(bi) + lineKey(line) });
      }
    }
  }
  return out;
}

/** 过程组的标题：说做了什么，不写步数。 */
export function groupTitle(turn: Turn): string {
  let sawThought = false;
  let sawTool = false;
  let sawError = false;
  for (const block of turn.blocks) {
    if (block.kind === 'reasoning') {
      sawThought = true;
    } else if (block.kind === 'tools') {
      sawTool = true;
    } else if (block.kind === 'error') {
      sawError = true;
    }
  }
  if (sawError) {
    return '出错了';
  }
  if (sawThought && sawTool) {
    return turn.closed ? '已完成分析、已调用工具' : '正在分析请求、正在调用工具';
  }
  if (sawTool) {
    return turn.closed ? '已调用工具' : '正在调用工具';
  }
  return turn.closed ? '已完成分析' : '正在分析请求';
}

/** 行标题：推理给首行，工具给状态，正文给首行。 */
export function titleOf(line: ChatLine, preview: boolean): string {
  if (line.kind === 'thought' && preview) {
    const cut = line.text.indexOf('\n');
    const head = (cut >= 0 ? line.text.substring(0, cut) : line.text).replace('**', '').trim();
    if (head.length > 0) {
      return '思考 · ' + (head.length > 26 ? head.substring(0, 26) + '…' : head);
    }
  }
  if (line.kind === 'tool') {
    const name = line.name.length > 0 ? line.name : '工具';
    const cut = line.text.indexOf('\n');
    const head = (cut >= 0 ? line.text.substring(0, cut) : line.text).trim();
    if (head.startsWith('{')) {
      const failed = head.indexOf('"ok":false') >= 0 || head.indexOf('"status":"error"') >= 0;
      return name + (failed ? ' · 失败' : ' · 完成');
    }
    return head.length > 0 ? name + ' · ' + head : name;
  }
  return lineTitle(line);
}

/** LazyForEach 的数据源：整体替换后通知刷新。 */
export class TurnSource implements IDataSource {
  private turns: Turn[] = [];
  private listeners: DataChangeListener[] = [];

  totalCount(): number {
    return this.turns.length;
  }

  getData(index: number): Turn {
    return this.turns[index];
  }

  registerDataChangeListener(listener: DataChangeListener): void {
    if (this.listeners.indexOf(listener) < 0) {
      this.listeners.push(listener);
    }
  }

  unregisterDataChangeListener(listener: DataChangeListener): void {
    const at = this.listeners.indexOf(listener);
    if (at >= 0) {
      this.listeners.splice(at, 1);
    }
  }

  /** 用新的轮次整体替换。 */
  replace(turns: Turn[]): void {
    this.turns = turns;
    for (const listener of this.listeners) {
      listener.onDataReloaded();
    }
  }

  count(): number {
    return this.turns.length;
  }

  /** 最后一个已结束轮的下标，供 next-input 时机使用。 */
  lastClosedIndex(): number {
    for (let i = this.turns.length - 1; i >= 0; i -= 1) {
      if (this.turns[i].closed) {
        return i;
      }
    }
    return -1;
  }
}

@Component
export struct TurnView {
  @Prop turn: Turn;
  @Prop palette: Palette;
  @Prop dark: boolean;
  @Prop policy: ChatPresentationPolicy;
  @Prop collapseTiming: string;
  @Prop isLastClosed: boolean = false;
  @Link opened: Map<string, boolean>;

  private isOpen(key: string): boolean {
    return this.opened.get(key) === true;
  }

  private flip(key: string): void {
    const next: Map<string, boolean> = new Map();
    this.opened.forEach((value: boolean, at: string) => {
      next.set(at, value);
    });
    next.set(key, !this.isOpen(key));
    this.opened = next;
  }

  /** 过程组是否收起：运行中的轮不折；next-input 时最后一个已结束的轮保持展开。 */
  private groupCollapsed(): boolean {
    if (this.turn.tools.length === 0 || this.policy.stepGrouping === 'none') {
      return false;
    }
    if (!this.turn.closed) {
      return false;
    }
    if (collapseTimingOf(this.collapseTiming) === 'next-input' && this.isLastClosed) {
      return false;
    }
    return !this.isOpen('g' + this.turn.key);
  }

  @Builder
  LineView(line: ChatLine) {
    Column({ space: 4 }) {
      if (foldable(line.kind)) {
        Row({ space: 5 }) {
          SymbolGlyph(this.isOpen(lineKey(line)) ? $r('sys.symbol.chevron_down')
            : $r('sys.symbol.chevron_right'))
            .fontSize(10)
            .fontColor([this.palette.textTertiary])
          Text(titleOf(line, this.policy.settledReasoningPreview))
            .fontSize(12)
            .fontColor(this.palette.textTertiary)
            .layoutWeight(1)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .width('100%')
        .onClick(() => {
          this.flip(lineKey(line));
        })
        if (this.isOpen(lineKey(line))) {
          MarkdownView({ text: lineDetail(line), dark: this.dark })
        }
      } else if (line.kind === 'user') {
        Row() {
          Text(line.text)
            .fontSize(14)
            .fontColor(this.palette.textPrimary)
            .backgroundColor(this.palette.pane)
            .borderRadius(12)
            .padding({ left: 12, right: 12, top: 8, bottom: 8 })
            .maxLines(20)
        }
        .width('100%')
        .justifyContent(FlexAlign.End)
      } else {
        MarkdownView({ text: line.text, dark: this.dark })
      }
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }

  @Builder
  ProcessGroup() {
    Column({ space: 6 }) {
      Row({ space: 5 }) {
        SymbolGlyph(this.groupCollapsed() ? $r('sys.symbol.chevron_right') : $r('sys.symbol.chevron_down'))
          .fontSize(10)
          .fontColor([this.palette.textTertiary])
        Text(groupTitle(this.turn))
          .fontSize(12)
          .fontColor(this.palette.textTertiary)
          .opacity(this.turn.closed ? 0.75 : 1)
          .layoutWeight(1)
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      .width('100%')
      .onClick(() => {
        this.flip('g' + this.turn.key);
      })

      if (!this.groupCollapsed()) {
        Scroll() {
          Column({ space: 6 }) {
            ForEach(this.turn.tools, (line: ChatLine) => {
              this.LineView(line)
            }, (line: ChatLine) => this.turn.key + ':' + lineKey(line))
          }
          .width('100%')
        }
        .constraintSize({ maxHeight: 260 })
        .scrollBar(BarState.Auto)
        .width('100%')
      }
    }
    .width('100%')
  }

  build() {
    Column({ space: 8 }) {
      ForEach(itemsOf(this.turn), (item: RowItem, at: number) => {
        if (item.kind === 'group') {
          this.ProcessGroup()
        } else {
          if (at < 3) {
            hilog.info(0x0000, 'hvoltide', 'item %{public}d kind=%{public}s len=%{public}d',
              at, item.line.kind, item.line.text.length);
          }
          this.LineView(item.line)
        }
      }, (item: RowItem) => item.key)
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }
}
